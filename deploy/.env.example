# Copy to deploy/.env (which is git-ignored) and fill in. Never commit .env.

# ClickHouse password for the "buffmon" user. Generate one:
#   openssl rand -base64 32
CLICKHOUSE_PASSWORD=

# Dashboard login. Generate both with:  buffmon-mint-token ui
# (it prints the login token once; keep that, put the two lines below here)
BUFFMON_UI_TOKEN_SHA256=
BUFFMON_SESSION_SECRET=

# Set to true when the dashboard is served over HTTPS.
BUFFMON_COOKIE_SECURE=false
