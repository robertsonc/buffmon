[Unit]
Description=buffmon site probe (STAMP, ICMP, TCP)
Documentation=https://github.com/robertsonc/buffmon/blob/main/docs/DESIGN.md
After=network-online.target time-sync.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
ExecStartPre=/usr/local/bin/buffmon-probe --config /etc/buffmon/probe.toml --check
ExecStart=/usr/local/bin/buffmon-probe --config /etc/buffmon/probe.toml
Restart=on-failure
RestartSec=10s

# The ingest token is a root-owned 0600 file on disk; systemd hands a private
# copy to this service only. probe.toml refers to it as
#   token_file = "${CREDENTIALS_DIRECTORY}/probe-token"
# so probe.toml itself holds no secrets and can be world-readable.
LoadCredential=probe-token:/etc/buffmon/probe-token
# One per authenticated STAMP session ([stamp.auth] key_file =
# "${CREDENTIALS_DIRECTORY}/stamp-dc1"), minted with buffmon-reflector --new-key.
#LoadCredential=stamp-dc1:/etc/buffmon/stamp-dc1.key

# --- Privileges ----------------------------------------------------------------
DynamicUser=yes
# Raw ICMP sockets (ICMP sessions, and reading routers' replies to route
# traces). Nothing else.
AmbientCapabilities=CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_RAW
NoNewPrivileges=yes

# --- Hardening -----------------------------------------------------------------
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectHostname=yes
# NOT ProtectClock=: it blocks adjtimex(2) entirely, and the probe needs a
# read-only adjtimex to learn whether the clock is synchronised (STAMP S bit).
# Without CAP_SYS_TIME the call cannot change the clock.
RestrictAddressFamilies=AF_INET AF_UNIX AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service adjtimex
SystemCallErrorNumber=EPERM
UMask=0077

MemoryMax=256M
TasksMax=256

[Install]
WantedBy=multi-user.target
