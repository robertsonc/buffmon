[Unit]
Description=buffmon STAMP reflector (RFC 8762, stateful)
Documentation=https://github.com/robertsonc/buffmon/blob/main/docs/DESIGN.md
After=network-online.target time-sync.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
ExecStart=/usr/local/bin/buffmon-reflector --config /etc/buffmon/reflector.toml
Restart=on-failure
RestartSec=5s

# Authenticated STAMP keys (keys_file = "${CREDENTIALS_DIRECTORY}/stamp-keys" in
# reflector.toml). Root-owned 0600 on disk; systemd hands this service a private
# copy at start, so restart after adding a key.
#LoadCredential=stamp-keys:/etc/buffmon/stamp-keys.toml

# --- Privileges ----------------------------------------------------------------
DynamicUser=yes
# UDP 862 is below 1024.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes

# --- Hardening -----------------------------------------------------------------
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectHostname=yes
# NOT ProtectClock=: see buffmon-probe.service (read-only adjtimex for the S bit).
RestrictAddressFamilies=AF_INET AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service adjtimex
SystemCallErrorNumber=EPERM
UMask=0077

MemoryMax=128M
TasksMax=16

[Install]
WantedBy=multi-user.target
